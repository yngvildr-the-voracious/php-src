# Made entirely with Claude (Anthropic's Claude Opus 5.5, in Claude Code).
# CentOS 7 build/test image matching a legacy production stack:
# Apache/2.4.6 (CentOS) + PHP 7.4.x as mod_php, gcc 4.8.5, glibc 2.17.
FROM docker.io/library/centos:7

# CentOS 7 is EOL: mirrorlist.centos.org is gone, packages live on vault.centos.org.
RUN sed -i -e 's/^mirrorlist=/#mirrorlist=/' \
           -e 's|^#\?baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|' \
           /etc/yum.repos.d/CentOS-*.repo \
 && yum -y -q install gcc gcc-c++ make autoconf file xz which procps-ng \
        httpd httpd-devel \
        libxml2-devel sqlite-devel openssl-devel zlib-devel libcurl-devel \
 && yum clean all

WORKDIR /dak
